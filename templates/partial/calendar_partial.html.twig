{% set months = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'] %}
<div class="row">
{% for key, month in stats.calendar %}
    <div class="col-12 col-lg-6">
    {% set month_total = 0 %}
    <h3 class="mt-4">{{ months[key % 12] }} {{ key // 12 }}</h3>
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Lun</th>
                <th>Mar</th>
                <th>Mié</th>
                <th>Jue</th>
                <th>Vie</th>
                <th>Sáb</th>
                <th>Dom</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {% for week in month %}
                {% set week_total = 0 %}
                <tr>
                    {% for d in week %}
                        {% if d %}
                            <td class="calendar-day {% if d.hours > 0 %}table-success{% elseif loop.index > 5 %}table-secondary{% endif %}">
                                <b>{{ d.day }}</b>
                                {% if d.hours > 0 %}
                                    <br><small>{{ d.hours }} h.</small>
                                    {% set week_total = week_total + d.hours %}
                                {% endif %}
                            </td>
                        {% else %}
                            <td class="calendar-day"></td>
                        {% endif %}
                    {% endfor %}
                    {% if week|length < 7 %}
                        <td colspan="{{ 7 - week|length }}"></td>
                    {% endif %}
                    <td><small>{{ week_total }} h.</small></td>
                </tr>
                {% set month_total = month_total + week_total %}
            {% endfor %}
        </tbody>
        <tfoot>
            <tr>
                <th colspan="7" class="text-end">Total horas lectivas:</th>
                <th>{{ month_total }} h.</th>
            </tr>
        </tfoot>
    </table>
    </div>
{% endfor %}
</div>

<div class="border border-tertiary rounded-3 mt-4 p-3">
    <h3>Exportar calendario (lista de jornadas)</h3>
    <form method="post" action="{{ path('export_calendar') }}">
        <input type="hidden" name="calendar" value="{{ stats.calendar|json_encode }}">
        <div class="row gy-2 align-items-end">
            <div class="col-12 col-sm-4 col-md-3">
                <label class="form-label" for="export_extra_columns">Nº de columnas extra</label>
                <input type="number" id="export_extra_columns" name="extra_columns" class="form-control" min="0" max="20" value="0">
            </div>
            <div class="col-12 col-sm-5 col-md-6">
                <div class="form-check">
                    <input type="checkbox" id="export_show_all_dates" name="show_all_dates" class="form-check-input">
                    <label class="form-check-label" for="export_show_all_dates">Mostrar todas las fechas (no solo las que tengan horas)</label>
                </div>
            </div>
            <div class="col-12 col-sm-3 col-md-3">
                <button type="submit" class="btn btn-outline-primary w-100">Exportar a Excel</button>
            </div>
        </div>
    </form>
</div>

<div class="border border-tertiary rounded-3 mt-4 p-3">
    <h3>Exportar calendario (vista mensual)</h3>
    <form method="post" action="{{ path('export_calendar_grid') }}">
        <input type="hidden" name="calendar" value="{{ stats.calendar|json_encode }}">
        <div class="row gy-2 align-items-end">
            <div class="col-12 col-sm-4 col-md-2">
                <label class="form-label" for="export_months_per_row">Meses por fila</label>
                <input type="number" id="export_months_per_row" name="months_per_row" class="form-control" min="1" max="12" value="3">
            </div>
            <div class="col-12 col-sm-8 col-md-7">
                <div class="form-check">
                    <input type="checkbox" id="export_show_hours_in_cell" name="show_hours_in_cell" class="form-check-input" checked>
                    <label class="form-check-label" for="export_show_hours_in_cell">Mostrar el número de horas dentro de cada casilla</label>
                </div>
                <div class="form-check">
                    <input type="checkbox" id="export_show_weekly_total" name="show_weekly_total" class="form-check-input">
                    <label class="form-check-label" for="export_show_weekly_total">Mostrar el total de horas semanales</label>
                </div>
                <div class="form-check">
                    <input type="checkbox" id="export_show_month_working_days_total" name="show_month_working_days_total" class="form-check-input">
                    <label class="form-check-label" for="export_show_month_working_days_total">Mostrar el total de jornadas de cada mes</label>
                </div>
            </div>
            <div class="col-12 col-sm-12 col-md-3">
                <button type="submit" class="btn btn-outline-primary w-100">Exportar a Excel</button>
            </div>
        </div>
    </form>
</div>
